{
	"hosting": {
		"public": ".output/public",
		"ignore": [
			"firebase.json",
			"**/.*",
			"**/node_modules/**"
		],
		"rewrites": [
			{
				"source": "**",
				"destination": "/index.html"
			}
		]
	},
	"emulators": {
		"auth": {
			"port": 9099
		},
		"database": {
			"port": 9001
		},
		"hosting": {
			"port": 5050
		},
		"ui": {
			"enabled": true
		},
		"singleProjectMode": true
	},
	"database": {
		"rules": "database.rules.json"
	}
}
